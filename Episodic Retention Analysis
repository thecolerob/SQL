    select *
    from samsung_2

    union all

    select *
    from vizio_2

    union all

    select *
    from web_2
)

, plays as (
    select *
    from new
)

, sub_history as (
    select *
    from subscription_history
)

, showmap as (
    select *
    from show_mappings
)

, playsandplans as (
    select
        sub_history.st
      , plays.ts
      , case
            when sub_history.endts is null then
                case
                    when sub_history.ets is null then
                        case
                            when sub_history.st is null then null
                            else timestamp_from_parts(year(current_date()) + 5, 1, 1, 0, 0, 0)
                        end
                    else sub_history.ets
                end
            else sub_history.endts
        end as endingts
      , plays.dt
      , plays.p
      , plays.t
      , plays.user_id
      , plays.plays
      , sub_history.cohort
      , sub_history.sub_id
      , sub_history.og_plan
      , sub_history.plan
    from plays
    left join sub_history
        on plays.user_id = sub_history.user_id
    where (plays.ts >= sub_history.st and plays.ts < endingts)
        or (sub_history.st is null and endingts is null)
)

, mapped as (
    select
        *
      , row_number() over (partition by sub_id order by ts) as pn
    from (
        select
            playsandplans.ts
          , playsandplans.dt
          , showmap.new_program as program
          , showmap.new_title as title
          , playsandplans.user_id
          , playsandplans.plays
          , playsandplans.cohort
          , playsandplans.sub_id
          , playsandplans.plan
          , playsandplans.og_plan
        from playsandplans
        left join showmap
            on playsandplans.p = showmap.old_program
                and playsandplans.t = showmap.old_title
    )
)

, show_name as (
    select *
    from mapped
    where program = 'Show Name'
        and title not ilike '%Trailer%'
)

, ep_count as (
    select
        r.account_email as email
      , count(distinct title) as episode_count
    from accounts r
    inner join show_name sn
        on sn.user_id = r.account_code
    group by
        1
)

, total as (
    select
        episode_count
      , count(email) as user_count
    from ep_count
    group by
        1
)

select
    episode_count
  , user_count
  , round((user_count * 100.0) / sum(user_count) over (), 2) as percent_of_cohort
  , round(
        sum(user_count) over (
            order by episode_count
            rows between current row and unbounded following
        ) * 100.0 / sum(user_count) over ()
      , 2
    ) as retention_rate
from total
order by
    episode_count;
