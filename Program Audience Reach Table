, sub_history as (
    select *
    from subscription.history
)

, showmap as (
    select *
    from show.mappings
)

, playsandplans as (
    select
        sub_history.st
      , plays.ts
      , case
            when sub_history.endts is null then
                case
                    when sub_history.ets is null then
                        case
                            when sub_history.st is null then null
                            else timestamp_from_parts(year(current_date()) + 5, 1, 1, 0, 0, 0)
                        end
                    else sub_history.ets
                end
            else sub_history.endts
        end as endingts
      , plays.dt
      , plays.p
      , plays.t
      , plays.user_id
      , plays.plays
      , sub_history.cohort
      , sub_history.sub_id
      , sub_history.og_plan
      , sub_history.plan
    from plays
    left join sub_history
        on plays.user_id = sub_history.user_id
    where (plays.ts >= sub_history.st and plays.ts < endingts)
        or (sub_history.st is null and endingts is null)
)

, mapped as (
    select
        *
      , row_number() over (partition by sub_id order by ts) as pn
    from (
        select
            playsandplans.ts
          , playsandplans.dt
          , showmap.new_program as program
          , showmap.new_title as title
          , playsandplans.user_id
          , playsandplans.plays
          , playsandplans.cohort
          , playsandplans.sub_id
          , playsandplans.plan
          , playsandplans.og_plan
        from playsandplans
        left join showmap
            on playsandplans.p = showmap.old_program
                and playsandplans.t = showmap.old_title
    )
)

, filtered as (
    select *
    from (
        select
            case
                when program = 'What is a Woman? [HD]' then 'What is a Woman?'
                when program = 'Am I Racist? [HD]' then 'Am I Racist?'
                when program = 'Terror on the Prairie [HD]' then 'Terror on the Prairie'
                when program = 'Run Hide Fight [HD]' then 'Run Hide Fight'
                when program = 'Lady Ballers [HD]' then 'Lady Ballers'
                else program
            end as new_program
          , dt
          , user_id
          , plan
          , sub_id
          , case
                when new_program = 'The Pendragon Cycle' then '2025-10-28'
                else min(date(ts)) over (partition by new_program)
            end as launch_dt
        from (
            select *
            from mapped
            where plan in ('insider_plus', 'all_access', 'insider', 'reader')
        )
    )
    where launch_dt <= dateadd(day, -1, current_date)
)

, recurly as (
    select
        uuid
      , account_code
      , plan_code
      , date(convert_timezone('utc', 'america/chicago', activated_at::timestamp_ntz)) as sub_activated_dt
      , date(convert_timezone('utc', 'america/chicago', expires_at::timestamp_ntz)) as sub_exp_dt
    from (
        select
            uuid
          , account_code
          , plan_code
          , activated_at
          , expires_at
        from dailywire_recurly.classic.subscriptions
        where plan_code in ('insider', 'insider_plus', 'all_access', 'reader')
    )
    where sub_activated_dt <= dateadd(day, -1, current_date)
)

select distinct
    uuid
  , plan_code
  , account_code
  , sub_activated_dt
  , sub_exp_dt
  , new_program as program
  , launch_dt
  , host_name as talent
from recurly r
left join filtered f
    on f.user_id = r.account_code
left join hosts.mapping h
    on h.video_name = f.new_program
);
