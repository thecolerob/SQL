## Program Audience Reach Base Table ##

## This table builds a subscription-level view of program reach by combining playback activity across web, mobile app, and connected TV platforms.
## It normalizes legacy and current Segment playback events, maps programs and titles into standardized names, and assigns each program a launch date based on first observed viewing activity.
## The resulting table creates one unique row for each subscription and program watched, supporting audience reach and reach analysis by plan, account, launch date, and talent.

create or replace table audience_show_reach_table as (

with webps as (
    select
        convert_timezone('utc', 'america/chicago', timestamp::timestamp_ntz) as ts
      , date(ts) as dt
      , coalesce(program, program_name, title) as p
      , title as t
      , nvl(
            case
                when user_id ilike '%legacy%' then trim(split(user_id, 'legacy-')[1], '""')
                else user_id
            end
          , anonymous_id
        ) as user_id
      , 1 as plays
    from segment_events.dw_website_prod.playback_started
    where dt >= '2020-01-01'
        and dt < '2025-04-07'
)

, webvps as (
    select
        convert_timezone('utc', 'america/chicago', timestamp::timestamp_ntz) as ts
