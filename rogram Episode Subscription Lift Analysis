## Program Episode Subscription Lift Analysis ##

## This query measures incremental subscription lift for a program across each episode release window.
## It uses the company's existing first-program attribution data at the program level, then groups attributed subscriptions into episode windows based on release timing.
## The resulting output shows cumulative and incremental attributed subscriptions by episode, helping estimate how each release contributed to overall subscriber growth.

with daily as (
    select
        dt
      , program
      , sum(rp) + sum(im) + sum(ia) + sum(aa) as total_fpa
    from first_program_attribution
    where program = 'Show Name'
        and dt >= date_trunc(year, current_date())
    group by
        1
      , 2
)

, eps as (
    select
        dt
      , program
      , total_fpa
      , case
            when dt <= '2026-02-22' then 'Ep 1'
            when dt between '2026-02-23' and '2026-03-21' then 'Ep 2'
            when dt between '2026-03-22' and '2026-05-10' then 'Ep 3'
            when dt >= '2026-05-11' then 'Ep 4'
            else 'Trailer'
        end as episode
      , sum(total_fpa) over (partition by program order by dt rows between unbounded preceding and current row) as cumulative_fpa
    from daily
    order by
        dt asc
)

, ep_totals as (
    select
        program
      , episode
      , max(cumulative_fpa) as cumulative_fpa
    from eps
    group by
        1
      , 2
)

select
    program
  , episode
  , cumulative_fpa
  , cumulative_fpa - lag(cumulative_fpa, 1, 0) over (partition by program order by cumulative_fpa) as incremental_fpa
from ep_totals
order by
    cumulative_fpa;
