## Podcast Anomaly Alerting View ##

## This view powers an n8n Slack alerting workflow that identifies unusual spikes in key podcast viewing and download data.
## It combines Spotify, YouTube, and RSS podcast performance data, calculates recent daily play totals, and compares them against rolling historical averages.
## The resulting view flags podcast episodes or shows with unusually high activity so the team can quickly review potential anomalies.

create or replace view n8n_podscribe_anomaly_flags (
    dt
  , source
  , show
  , total_plays
  , dow
  , rolling_avg_7d
  , ak_avg_last4fridays
  , flag
) as (

with plays_30d as (
    select
        'spotify' as source
      , video_series_title as show
      , video_episode_title
      , video_episode_guid
      , post_date
      , date as dt
      , dayofweekiso(date) as dow
      , episode_number
      , max(views) - lag(max(views), 1, 0) over (partition by video_episode_guid order by dt) as plays
    from spotify_video_plays
    where episode_number > 0
        and breakout = false
        and post_date >= dateadd(day, -30, current_date)
        and dt < current_date
    group by
        1
      , 2
      , 3
      , 4
      , 5
      , 6
      , 7
      , 8

    union all

    select
        'youtube' as source
      , case
            when video_series_title in ('Andrew Klavan (YouTube)', 'Ben Shapiro (YouTube)', 'Matt Walsh (YouTube)', 'Michael Knowles (YouTube)') then concat('The ', replace(video_series_title, ' (YouTube)'), ' Show')
            when video_series_title in ('Jordan B Peterson (YouTube)') then 'The Jordan B. Peterson Podcast'
            else replace(video_series_title, ' (YouTube)')
        end as show
      , video_episode_title
      , video_episode_guid
      , post_date
      , date as dt
      , dayofweekiso(date) as dow
      , episode_number
      , max(views) - lag(max(views), 1, 0) over (partition by video_episode_guid order by dt) as plays
    from youtube_plays
    where episode_number > 0
        and breakout = false
        and post_date >= dateadd(day, -30, current_date)
        and dt < current_date
    group by
        1
      , 2
      , 3
      , 4
      , 5
      , 6
      , 7
      , 8

    union all

    select
        'rss' as source
      , podcast_series_title as show
      , podcast_episode_title
      , podcast_episode_guid
      , post_date
      , date as dt
      , dayofweekiso(date) as dow
      , episode_number
      , sum(downloads) as plays
    from rss_plays
    where podcast_series_title is not null
        and episode_number > 0
        and (breakout = false or breakout is null)
        and post_date >= dateadd(day, -30, current_date)
        and dt < current_date
    group by
        1
      , 2
      , 3
      , 4
      , 5
      , 6
      , 7
      , 8
)

, agg as (
    select
        dt
      , source
      , show
      , dow
      , sum(case when plays < 0 then 0 else plays end) as total_plays
    from plays_30d
    group by
        1
      , 2
      , 3
      , 4
    order by
        1 asc
      , 3
)

, rolling_calc as (
    select
        dt
      , source
      , show
      , total_plays
      , dow
      , round(avg(total_plays) over (partition by source, show order by dt rows between 6 preceding and current row)) as rolling_avg_7d
      , case
            when dow = 5 then round(avg(total_plays) over (partition by source, show, dow order by dt rows between 4 preceding and 1 preceding))
        end as ak_avg_last4fridays
    from agg
)

select
    *
  , case
        when show != 'The Andrew Klavan Show' and total_plays > rolling_avg_7d * 2.5 then 1
        when show = 'The Andrew Klavan Show' and dow = 5 then
            case
                when total_plays > ak_avg_last4fridays * 2.5 then 1
                else 0
            end
        else 0
    end as flag
from rolling_calc
where flag = 1
    and dt >= dateadd(day, -1, current_date)
order by
    source
  , show
  , dt
);
